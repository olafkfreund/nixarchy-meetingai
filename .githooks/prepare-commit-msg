#!/usr/bin/env bash
# Automatically bump Lennette semver on commit.
set -euo pipefail

COMMIT_MSG_FILE="${1:-}"
COMMIT_SOURCE="${2:-}"

# Skip auto-bump on merge, squash, or amend
if [ "$COMMIT_SOURCE" = "merge" ] || [ "$COMMIT_SOURCE" = "commit" ] || [ "$COMMIT_SOURCE" = "squash" ]; then
    exit 0
fi

# Skip if environment variable SKIP_BUMP is set
if [ "${SKIP_BUMP:-0}" = "1" ]; then
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

if [ -f "$REPO_ROOT/scripts/bump-version.sh" ]; then
    "$REPO_ROOT/scripts/bump-version.sh" auto "$COMMIT_MSG_FILE"
fi
