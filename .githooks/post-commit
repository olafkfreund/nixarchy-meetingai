#!/usr/bin/env bash
# Automatically bump Lennette semver, then commit the bump so the tree is clean.
#
# Why not prepare-commit-msg: at that stage git has already assembled the tree,
# so a bump there can only land in the *next* commit and leaves Cargo.toml and
# Cargo.lock modified after every commit.
#
# Why not amend here: git holds index locks while post-commit runs, so a nested
# `git commit --amend` cannot reliably include the staged bump. Instead the bump
# lands in a small follow-up commit, which keeps the working tree clean.
set -euo pipefail

GIT_DIR="$(git rev-parse --git-dir)"
lock="$GIT_DIR/lennette-bump.lock"

# The follow-up commit runs this hook again; the lock stops the recursion.
if [ -e "$lock" ]; then
    exit 0
fi

# Opt out, and never bump during a rebase, merge or cherry-pick.
if [ "${SKIP_BUMP:-0}" = "1" ]; then
    exit 0
fi
for marker in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD; do
    if [ -e "$GIT_DIR/$marker" ]; then
        exit 0
    fi
done

# Never run for the bump commit itself (it carries the version already).
last_message="$(git log -1 --pretty=%s)"
case "$last_message" in
    "chore(release): bump version"*) exit 0 ;;
esac

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
if [ ! -f "$REPO_ROOT/scripts/bump-version.sh" ]; then
    exit 0
fi

message_file="$(mktemp)"
cleanup() {
    rm -f "$message_file" "$lock"
}
trap cleanup EXIT INT TERM
: >"$lock"

# bump treats an existing path as a message file, so hand it one. Use the
# message of the commit that just landed to pick the bump kind.
git log -1 --pretty=%B >"$message_file"
"$REPO_ROOT/scripts/bump-version.sh" auto "$message_file"

if git diff --quiet -- Cargo.toml Cargo.lock; then
    exit 0
fi

git add -- Cargo.toml Cargo.lock
git commit --quiet --no-verify -m "chore(release): bump version"
