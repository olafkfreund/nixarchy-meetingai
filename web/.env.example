# Copy to .env for local development, or set these in your host's environment.
# Never commit real credentials.

# Resend API key. Create one at https://resend.com/api-keys
# Works from Cloudflare Workers, unlike SMTP, because it is a plain HTTPS API.
RESEND_API_KEY=re_...

# Where your copy of each waitlist signup is delivered.
WAITLIST_NOTIFY_EMAIL=harsh@itssingularity.com

# Optional. Defaults to "Lennette <harsh@itssingularity.com>".
# The domain must be verified in Resend before you can send to strangers.
WAITLIST_FROM=Lennette <harsh@itssingularity.com>
