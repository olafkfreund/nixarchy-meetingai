# Copy to .env for local development, or set these in your host's environment.
# Never commit real credentials.

# Zoho India: smtp.zoho.in (free/personal) or smtppro.zoho.in (paid domain).
# US uses .com, EU uses .eu.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465

# Full mailbox address.
SMTP_USER=you@yourdomain.com
# App password from Zoho -> Security -> App Passwords (not your login password).
SMTP_PASSWORD=

# Defaults to SMTP_USER when omitted.
SMTP_FROM=you@yourdomain.com

# Where your copy of each waitlist signup is delivered.
WAITLIST_NOTIFY_EMAIL=you@yourdomain.com
