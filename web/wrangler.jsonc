{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lennette",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".output/server/index.mjs",
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "lennette.itssingularity.com",
      "custom_domain": true
    }
  ]
}
