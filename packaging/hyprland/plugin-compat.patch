+// Compose public surfaces directly. Overview hooks and their cached display
+// snapshots belong to the local monitor, never to the private export scene.
+void IHyprRenderer::renderPrivateScene(CRenderContext& ctx, PHLMONITOR monitor, const Time::steady_tp& now) {
+    renderAllClientsForWorkspace(ctx, monitor, monitor->m_activeWorkspace, now, {}, 1.F);
+    const CBox geometry{0, 0, monitor->m_transformedSize.x, monitor->m_transformedSize.y};
+    renderLockscreen(ctx, monitor, now, geometry);
+    renderIME(ctx, monitor, now, geometry);
+}
