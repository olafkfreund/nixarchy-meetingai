+// Recompose from surfaces, never from displayed pixels or the monitor blur cache.
+// Both SHM and DMA-BUF exports (including temporary frames) use this source.
+bool CScreenshareFrame::preparePrivateCapture() {
+    if (m_session->m_type != SHARE_MONITOR && m_session->m_type != SHARE_REGION)
+        return true;
+
+    // A pending-permission snapshot may predate a private_overlay rule change.
+    m_session->m_tempFB.reset();
+
+    const auto MONITOR = m_session->monitor();
+    const auto SOURCE  = MONITOR->isMirror() ? MONITOR->m_mirrorOf.lock() : MONITOR;
+    if (!SOURCE)
+        return false;
+
+    m_privateCaptureFB = g_pHyprRenderer->createFB();
+    if (!m_privateCaptureFB->alloc(SOURCE->m_transformedSize.x, SOURCE->m_transformedSize.y))
+        return false;
+    m_privateCaptureFB->setImageDescription(NColorManagement::DEFAULT_SRGB_IMAGE_DESCRIPTION);
+
+    Render::SRenderOptions options;
+    options.sceneResources = makeShared<Render::CSceneResources>(g_pHyprRenderer->createFB());
+    CRegion damage         = {0, 0, SOURCE->m_transformedSize.x, SOURCE->m_transformedSize.y};
+    if (!g_pHyprRenderer->beginRender(SOURCE, damage, Render::RENDER_MODE_FULL_FAKE, {}, m_privateCaptureFB, false, options))
+        return false;
+
+    bool                      finishing = false;
+    const Render::CScopeGuard cleanup([&] {
+        if (!finishing)
+            g_pHyprRenderer->abortRender();
+    });
+    auto&                     ctx = g_pHyprRenderer->context();
+    ctx.m_privateOverlayCapture   = true;
+    ctx.m_blockSurfaceFeedback    = true;
+    ctx.m_data.blockScreenShader  = true;
+    g_pHyprRenderer->draw(ctx, CClearPassElement::SClearData{{0, 0, 0, 1}}, damage);
+    Render::CMonitorScene scene{SOURCE};
+    scene.draw(ctx, Time::steadyNow());
+    finishing = true;
+    g_pHyprRenderer->endRender();
+    return true;
+}
